# ── core ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# Atlas → Cluster → Connect → Drivers. Remember to URL-encode a password that
# contains @ : / ? # [ ] — and to add your IP under Network Access.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/pulsechat?retryWrites=true&w=majority

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (Express *and* Socket.io).
CLIENT_URL=http://localhost:5173

# ── AI provider — pick ONE ───────────────────────────────────────────
# The key never leaves the server. Leave all three blank and the assistant
# degrades gracefully instead of crashing.
AI_PROVIDER=gemini

GEMINI_API_KEY=
# Use the `-latest` alias, not a pinned id like gemini-2.0-flash: pinned ids get
# retired (404) or sit on a zero free-tier quota (429).
GEMINI_MODEL=gemini-flash-latest

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Guard rails so a public demo cannot drain your quota.
AI_CONTEXT_MESSAGES=10
AI_MAX_OUTPUT_TOKENS=800
AI_REQUESTS_PER_HOUR=30

# ── the assistant's identity ─────────────────────────────────────────
BOT_NAME=Pulse AI
