# ── backend ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# false → every call goes to VITE_API_URL / VITE_SOCKET_URL (the normal setting)
# true  → the UI runs against in-memory fixtures, no backend needed at all
VITE_DEMO_MODE=false

# ── firebase storage (optional — used for image & file sharing) ───────
# Without these, uploads fall back to a local object URL preview.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# NOTE: never put the AI provider key here — it lives only in server/.env
